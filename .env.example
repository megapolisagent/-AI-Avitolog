# Шаблон .env — копия без реальных значений, безопасно коммитить.
# Реальный .env с настоящими ключами защищён .gitignore, в git не попадает.

AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Ниже — поля, структура которых стандартна для OAuth2 (client_credentials),
# но точные значения (endpoint'ы Avito) НЕ подтверждены официальной документацией
# (developers.avito.ru заблокирован для автоматического чтения) — заполнить,
# когда владелец пришлёт содержимое страницы из своего аккаунта.
AVITO_TOKEN_URL=[УТОЧНИТЬ — не подтверждено]
AVITO_API_BASE_URL=[УТОЧНИТЬ — не подтверждено]
